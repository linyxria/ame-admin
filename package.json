{
  "name": "ame-admin",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev:server": "pnpm --filter @ame-admin/server run dev",
    "dev:web": "pnpm --filter @ame-admin/web run dev",
    "build:web": "pnpm --filter @ame-admin/web run build",
    "typecheck:server": "pnpm --filter @ame-admin/server run typecheck",
    "db:up": "pnpm --filter @ame-admin/server run db:up",
    "db:down": "pnpm --filter @ame-admin/server run db:down",
    "db:setup": "pnpm --filter @ame-admin/server run db:setup",
    "test": "pnpm --filter @ame-admin/server run test && pnpm --filter @ame-admin/web run test",
    "lint": "biome lint server web",
    "format": "biome format --write server web",
    "check": "biome check server web",
    "check:write": "biome check --write server web"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8"
  }
}
