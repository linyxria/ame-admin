{
  "name": "@ame-admin/server",
  "version": "1.0.50",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun run src/scripts/seed-admin.ts",
    "db:setup": "pnpm run db:migrate && pnpm run db:seed",
    "db:studio": "drizzle-kit studio",
    "test": "bun test",
    "lint": "pnpm -w run lint",
    "format": "pnpm -w run format",
    "check": "pnpm -w run check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.3",
    "better-auth": "^1.7.27",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "elysia": "latest",
    "openai": "^7.63.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  },
  "module": "src/index.js"
}
